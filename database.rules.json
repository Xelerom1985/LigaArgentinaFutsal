{
  "rules": {
    "clubes": {
      ".read": true,
      "$id": {
        ".validate": "newData.hasChildren(['nombre', 'zonaId']) && newData.child('nombre').isString() && newData.child('nombre').val().length > 0 && newData.child('nombre').val().length <= 60",
        ".write": "(auth != null && (auth.token.email == 'admin@liga-argentina-futsal.app' || root.child('admins/' + auth.uid + '/activo').val() == true))"
      }
    },
    "arbitros": {
      ".read": "(auth != null && (auth.token.email == 'admin@liga-argentina-futsal.app' || root.child('admins/' + auth.uid + '/activo').val() == true))",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['nombre', 'apellido', 'pin']) && newData.child('pin').isString() && newData.child('pin').val().matches(/^[0-9]{4}$/)",
        ".write": "(auth != null && (auth.token.email == 'admin@liga-argentina-futsal.app' || root.child('admins/' + auth.uid + '/activo').val() == true))"
      }
    },
    "partidos": {
      ".read": true,
      ".indexOn": [
        "arbitroUid",
        "fecha",
        "act"
      ],
      "$id": {
        ".read": "auth != null && data.child('arbitroUid').val() == auth.uid",
        "resultados": {
          ".write": "auth != null && data.parent().child('arbitroUid').val() == auth.uid && data.parent().child('estado').val() != 'cerrado' && root.child('arbitros/' + auth.uid + '/activo').val() == true",
          "$cat": {
            ".validate": "newData.isString() && newData.val().matches(/^(L|E|V|C)$/)"
          }
        },
        "estado": {
          ".write": "auth != null && data.parent().child('arbitroUid').val() == auth.uid && data.val() != 'cerrado' && newData.val() != 'cerrado' && root.child('arbitros/' + auth.uid + '/activo').val() == true"
        },
        "actualizado": {
          ".write": "auth != null && data.parent().child('arbitroUid').val() == auth.uid && root.child('arbitros/' + auth.uid + '/activo').val() == true"
        },
        "actualizadoPor": {
          ".write": "auth != null && data.parent().child('arbitroUid').val() == auth.uid && root.child('arbitros/' + auth.uid + '/activo').val() == true"
        },
        "hojas": {
          "$cat": {
            ".write": "auth != null && data.parent().parent().child('arbitroUid').val() == auth.uid && data.parent().parent().child('estado').val() != 'cerrado' && root.child('arbitros/' + auth.uid + '/activo').val() == true",
            "borrada": {
              ".write": "newData.val() == true && ((now - 291600000) - ((now - 291600000) % 604800000)) > ((data.parent().child('subido').val() - 291600000) - ((data.parent().child('subido').val() - 291600000) % 604800000))"
            }
          }
        },
        "act": {
          ".write": "auth != null && data.parent().child('arbitroUid').val() == auth.uid && root.child('arbitros/' + auth.uid + '/activo').val() == true",
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        ".write": "(auth != null && (auth.token.email == 'admin@liga-argentina-futsal.app' || root.child('admins/' + auth.uid + '/activo').val() == true))",
        "cancelaciones": {
          ".write": "auth != null && data.parent().child('arbitroUid').val() == auth.uid && data.parent().child('estado').val() != 'cerrado' && root.child('arbitros/' + auth.uid + '/activo').val() == true",
          "$cat": {
            ".validate": "newData.hasChildren(['motivo']) && newData.child('motivo').isString() && newData.child('motivo').val().length > 0 && newData.child('motivo').val().length <= 300"
          }
        }
      }
    },
    "hojas": {
      ".read": "(auth != null && (auth.token.email == 'admin@liga-argentina-futsal.app' || root.child('admins/' + auth.uid + '/activo').val() == true))",
      "$pid": {
        ".read": "auth != null && root.child('partidos/' + $pid + '/arbitroUid').val() == auth.uid",
        "$cat": {
          ".write": "(auth != null && root.child('partidos/' + $pid + '/arbitroUid').val() == auth.uid && root.child('partidos/' + $pid + '/estado').val() != 'cerrado' && root.child('arbitros/' + auth.uid + '/activo').val() == true) || (!newData.exists() && root.child('partidos/' + $pid + '/hojas/' + $cat + '/subido').val() != null && ((now - 291600000) - ((now - 291600000) % 604800000)) > ((root.child('partidos/' + $pid + '/hojas/' + $cat + '/subido').val() - 291600000) - ((root.child('partidos/' + $pid + '/hojas/' + $cat + '/subido').val() - 291600000) % 604800000)))",
          ".validate": "newData.hasChildren(['data', 'subido']) && newData.child('data').isString() && newData.child('data').val().length < 2200000"
        },
        ".write": "(auth != null && (auth.token.email == 'admin@liga-argentina-futsal.app' || root.child('admins/' + auth.uid + '/activo').val() == true))"
      }
    },
    "config": {
      ".read": true,
      ".write": "(auth != null && auth.token.email == 'admin@liga-argentina-futsal.app')",
      "torneoActual": {
        ".validate": "newData.isString() && newData.val().length <= 60"
      },
      "torneos": {
        "$id": {
          ".validate": "newData.hasChildren(['nombre']) && newData.child('nombre').isString() && newData.child('nombre').val().length <= 60"
        }
      }
    },
    "admins": {
      ".read": "(auth != null && auth.token.email == 'admin@liga-argentina-futsal.app')",
      ".write": "(auth != null && auth.token.email == 'admin@liga-argentina-futsal.app')",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['nombre', 'pin']) && newData.child('pin').isString() && newData.child('pin').val().matches(/^[0-9]{4}$/)"
      }
    },
    "metricas": {
      ".read": "(auth != null && auth.token.email == 'admin@liga-argentina-futsal.app')",
      ".write": "(auth != null && auth.token.email == 'admin@liga-argentina-futsal.app')",
      "d": {
        "$dia": {
          ".validate": "$dia.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
          "$g": {
            ".validate": "$g.matches(/^(gen|disp|modo|horas|vistas|zonas|tablas|miclub|acc|kb)$/)",
            "$k": {
              ".write": "newData.exists()",
              ".validate": "$k.matches(/^[a-z0-9-]{1,40}$/) && newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 50000"
            }
          }
        }
      },
      "e": {
        "$dia": {
          ".validate": "$dia.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
          "$h": {
            ".validate": "$h.matches(/^[a-z0-9]{1,12}$/)",
            "n": {
              ".write": "newData.exists()",
              ".validate": "newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 20"
            },
            "msg": {
              ".write": "!data.exists() && newData.exists()",
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "$otro": {
              ".validate": false
            }
          }
        }
      },
      "vivo": {
        "$id": {
          ".write": "$id.matches(/^[a-z0-9]{8,24}$/)",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}